  "phrases": [
    {
      "i": 0,
      "text": "Hai una casa a Padova?",
      "vo_start": 0.0,
      "vo_end": 1.392,
      "start": 0.5,
      "end": 1.892
    },
    {
      "i": 1,
      "text": "Tailor Homes se ne prende cura, ogni giorno.",
      "vo_start": 2.117,
      "vo_end": 4.952,
      "start": 2.617,
      "end": 5.452
    },
    {
      "i": 2,
      "text": "Pulizie, manutenzione, ospiti: ci pensiamo noi.",
      "vo_start": 5.642,
      "vo_end": 8.378,
      "start": 6.142,
      "end": 8.878
    },
    {
      "i": 3,
      "text": "Valorizziamo la tua casa, con home staging e fotografia professionale.",
      "vo_start": 8.659,
      "vo_end": 14.75,
      "start": 9.159,
      "end": 15.25
    },
    {
      "i": 4,
      "text": "Gestiamo canali online, marketing e distribuzione.",
      "vo_start": 15.309,
      "vo_end": 18.555,
      "start": 15.809,
      "end": 19.055
    },
    {
      "i": 5,
      "text": "E ti affianchiamo nella consulenza immobiliare, legale e fiscale.",
      "vo_start": 18.883,
      "vo_end": 22.675,
      "start": 19.383,
      "end": 23.175
    },
    {
      "i": 6,
      "text": "La tua casa, su misura.",
